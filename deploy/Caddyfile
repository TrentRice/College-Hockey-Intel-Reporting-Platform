# Caddy for the public CHIRP dashboard (docker-compose.prod.yml, docs/deploy.md).
# DOMAIN comes from .env. Caddy gets and renews the HTTPS certificate on its own, and sends
# http:// visitors to https://. WebSockets (which Streamlit runs on) pass through as-is.

{$DOMAIN} {
	encode zstd gzip
	reverse_proxy dashboard:8501

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}
