# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real secrets.

# --- App ---
ENVIRONMENT=development            # development | staging | production
LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR

# --- MLflow ---
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_ARTIFACT_ROOT=./mlruns      # or an s3:// bucket URI in production
MLFLOW_MODEL_NAME=my-model
MLFLOW_MODEL_STAGE=Production      # Staging | Production

# --- Postgres (hockey database, docker-compose.yml) ---
POSTGRES_USER=hockey
POSTGRES_PASSWORD=hockey           # local only; use a real secret anywhere shared
POSTGRES_DB=hockey
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://hockey:hockey@localhost:5432/hockey

# --- Serving app ---
API_HOST=127.0.0.1                 # this machine only. Never 0.0.0.0: CHN data must stay private
API_PORT=8000
API_KEY=                           # required in the X-API-Key header; generate: python -c "import secrets; print(secrets.token_urlsafe(32))"

# --- AWS (only needed for deploy, not local dev) ---
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=
ECR_REPOSITORY_NAME=
ECS_CLUSTER_NAME=
ECS_SERVICE_NAME=

# --- External data source credentials (if your ingestion needs them) ---
# DATA_SOURCE_API_KEY=
