# Copy this file to .env and fill in real values. .env is gitignored: never commit it.

# --- Postgres (docker-compose.yml) ---
POSTGRES_USER=hockey
POSTGRES_PASSWORD=hockey           # local only
POSTGRES_DB=hockey
POSTGRES_PORT=5432                 # published on 127.0.0.1 only
DATABASE_URL=postgresql://hockey:hockey@localhost:5432/hockey

# --- API and dashboard ---
API_PORT=8000                      # published on 127.0.0.1 only. CHN data must stay private
DASHBOARD_PORT=8501
API_KEY=                           # required in the X-API-Key header; generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
